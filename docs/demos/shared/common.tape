# Run from the repository root with: bash docs/demos/record.sh <path.tape>
Require bash
Set Shell bash
Set Width 1760
Set Height 1120
Set FontSize 32
Set Padding 24
Set TypingSpeed 90ms
Set Framerate 20
Set PlaybackSpeed 1.25
Set CursorBlink false
Set Theme "Dracula"

Hide
Type@0ms "source docs/demos/shared/setup.sh"
Enter
Wait+Screen /DEMO_READY/
Ctrl+L
Show
