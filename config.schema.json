  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vy configuration",
  "type": "object",
  "properties": {
    "version": {
      "description": "Configuration format version, independent of the vy release version.\nOmitted versions are treated as version 1 for existing configurations.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 1,
      "const": 1
    },
    "scroll_lines": {
      "type": "integer",
      "format": "uint",
      "minimum": 1,
      "default": 3
    },
    "keybinds": {
      "default": {
        "component": {
          "document": {
            "up": [
              "K",
              "ScrollUp",
              "Up"
            ],
            "down": [
              "Down",
              "J",
              "ScrollDown"
            ],
            "page_up": [
              "Ctrl+B",
              "PageUp"
            ],
            "page_down": [
              "Ctrl+F",
              "PageDown"
            ],
            "half_page_up": [
              "Ctrl+U"
            ],
            "half_page_down": [
              "Ctrl+D"
            ],
            "move_to_head": [
              "G",
              "Home"
            ],
            "move_to_tail": [
              "End",
              "Shift+G"
            ],
            "toggle": [
              "Enter",
              "LeftDown",
              "Space"
            ],
            "expand_all": [
              "E"
            ],
            "collapse_all": [
              "Shift+E"
            ],
            "toggle_overflow_mode": [
              "Z"
            ],
            "toggle_line_numbers": [
              "Alt+N"
            ]
          },
