            "insert_newline": [
              "Shift+Enter"
            ],
            "backward": [
              "Ctrl+B",
              "Left"
            ],
            "forward": [
              "Ctrl+F",
              "Right"
            ],
            "move_up": [
              "Up"
            ],
            "move_down": [
              "Down"
            ],
            "move_to_line_head": [
              "Ctrl+A",
              "Home"
            ],
            "move_to_line_tail": [
              "Ctrl+E",
              "End"
            ],
            "move_to_head": [
              "Ctrl+Home"
            ],
            "move_to_tail": [
              "Ctrl+End"
            ],
            "move_to_previous_nearest": [
              "Alt+B",
              "Ctrl+Left"
            ],
            "move_to_next_nearest": [
              "Alt+F",
              "Ctrl+Right"
            ],
            "erase": [
              "Backspace",
              "Ctrl+H"
            ],
            "erase_forward": [
