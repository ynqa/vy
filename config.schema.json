            ],
            "erase_to_next_nearest": [
              "Alt+D",
              "Ctrl+Delete"
            ]
          }
        },
        "view": {
          "browse": {
            "input": {
              "exit": [
                "Ctrl+C",
                "Esc"
              ]
            },
            "focus": {
              "back": [
                "Esc"
              ]
            },
            "toggle_focus": [
              "Tab"
            ],
            "toggle_side_by_side": [
              "S"
            ],
            "open_command_editor": [
              ":",
              "Shift+:"
            ],
            "close_command_editor": [
              "Ctrl+C",
              "Esc"
            ],
            "submit_command": [
              "Enter"
            ],
            "complete_command": [
              "Tab"
            ],
            "open_search_editor": [
              "/"
            ],
            "close_search_editor": [
              "Ctrl+C",
              "Esc"
            ],
            "submit_search": [
              "Enter"
            ],
            "older_search_history": [
              "Up"
            ],
            "newer_search_history": [
              "Down"
            ],
            "next_search": [
