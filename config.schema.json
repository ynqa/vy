            "move_to_parent": [
              "Shift+H"
            ],
            "expand_or_move_to_first_child": [
              "L",
              "Right"
            ],
            "move_to_next_sibling": [
              "Shift+J"
            ],
            "move_to_previous_sibling": [
              "Shift+K"
            ]
          },
          "help": {
            "back": [
              "Esc"
            ]
          },
          "preview": {
            "back": [
              "Esc"
            ],
            "copy_selection": [
              "Y"
            ]
          },
          "hstr": {
            "back": [
              "Esc"
            ],
            "toggle_focus": [
              "Tab"
            ],
            "recall_selection": [
              "Enter",
              "LeftDown"
            ]
          },
          "flatten": {
            "back": [
              "Esc"
            ],
            "cancel_execution": [
              "Ctrl+C"
            ],
            "execute_query": [
              "Enter"
            ],
            "open_query_editor": [
              ":",
              "Shift+:"
            ],
            "close_query_editor": [
              "Esc"
            ],
            "goto_selection": [
              "Enter",
              "LeftDown"
            ]
          },
          "jaq": {
            "back": [
              "Esc"
            ],
            "cancel_execution": [
              "Ctrl+C"
            ],
            "toggle_focus": [
              "Tab"
            ],
            "toggle_side_by_side": [
              "S"
            ]
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/Keybinds"
        }
      ]
    },
    "theme": {
      "default": {
        "feedback": {
          "label_style": "attr=bold",
          "normal_style": "",
          "loading_style": "fg=yellow",
          "success_style": "fg=green",
          "warning_style": "fg=yellow",
          "error_style": "fg=red",
          "hint_style": "fg=darkgrey"
        },
        "editor": {
